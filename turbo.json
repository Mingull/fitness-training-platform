{
	"$schema": "https://v2-9-12.turborepo.dev/schema.json",
	"ui": "tui",
	"globalEnv": ["NODE_ENV", "API_URL"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**", "!.turbo/**", "!.next/server/app/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"dev": {
			"dependsOn": ["^dev:api"],
			"persistent": true,
			"cache": false
		},
		"dev:api": {
			"persistent": true,
			"cache": false
		},
		"generate-types": {
			"dependsOn": ["^dev"]
		}
	}
}
