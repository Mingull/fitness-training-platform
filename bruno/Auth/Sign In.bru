meta {
  name: Sign In
  type: http
  seq: 1
}

post {
  url: {{host}}/auth/sign-in
  body: json
  auth: none
}

body:json {
  {
    "email": "test@email.com",
    "password": "Test@123"
  }
}

vars:post-response {
  access_token: res.body.data.accessToken
  refresh_token: res.body.data.refreshToken
}
