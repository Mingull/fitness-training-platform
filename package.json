{
	"name": "fitness-training-platform",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"dev:api": "dotnet watch run --project apps/api/Fitness.Api.csproj --launch-profile https",
		"lint": "turbo run lint",
		"test": "turbo run test",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"check-types": "turbo run check-types",
		"generate-types": "openapi-typescript http://localhost:7081/openapi/v1.json -o packages/contracts/src/index.ts --watch"
	},
	"dependencies": {
		"openapi-typescript": "^7.13.0"
	},
	"devDependencies": {
		"prettier": "^3.8.3",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"tsx": "^4.22.3",
		"turbo": "^2.9.14",
		"typescript": "6.0.3"
	},
	"packageManager": "pnpm@10.33.3",
	"engines": {
		"node": ">=24"
	},
	"pnpm": {
		"overrides": {
			"lightningcss": "1.30.1",
			"react": "19.2.0",
			"react-dom": "19.2.0"
		}
	}
}
