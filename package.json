{
	"name": "fitness-training-platform",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"dev:api": "dotnet watch run --project apps/api/Fitness.API/Fitness.API.csproj --launch-profile https",
		"lint": "turbo run lint",
		"test": "turbo run test",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"check-types": "turbo run check-types",
		"generate-types": "openapi-typescript http://localhost:7081/openapi/v1.json -o packages/contracts/src/index.ts --watch"
	},
	"dependencies": {
		"openapi-typescript": "^7.13.0"
	},
	"devDependencies": {
		"prettier": "^3.8.3",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"tsx": "^4.22.3",
		"turbo": "^2.9.14",
		"typescript": "6.0.3"
	},
	"packageManager": "pnpm@11.6.0",
	"engines": {
		"node": ">=24"
	}
}